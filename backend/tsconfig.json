{
  "compilerOptions": {
    "target": "ES2022",
    "esModuleInterop": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "src/**/*",
    "index.ts",
    "app.ts",
    "prisma.config.ts",
    "systemPrompt.ts",
    "data.ts"
  ]
}
